{
  "name": "rk-varaha-crm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @rk/api\" \"npm run dev -w @rk/web\"",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "db:reset": "prisma migrate reset",
    "test:integration": "node scripts/integration-tests.mjs",
    "test:unit": "npm run test --workspaces --if-present",
    "auth:init-dev": "node scripts/init-auth-dev.mjs",
    "auth:bootstrap-admin": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --tsconfig apps/api/tsconfig.json scripts/bootstrap-admin.ts",
    "test:auth:live": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --tsconfig apps/api/tsconfig.json scripts/auth-live-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.0.0",
    "globals": "^16.4.0",
    "playwright": "^1.63.0",
    "prettier": "^3.6.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@nestjs/platform-express": {
      "multer": "^2.4.0"
    }
  }
}
