generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CompanyLifecycleStatus {
  PROSPECT
  CUSTOMER
  PARTNER
  OTHER
}

enum ContactLifecycleStatus {
  LEAD
  PROSPECT
  CUSTOMER
  OTHER
}

enum RecordResource {
  COMPANIES
  CONTACTS
  LEADS
  DEALS
  TASKS
}

enum RecordScope {
  OWN
  TEAM
  ORGANIZATION
}

enum ActivitySubjectType {
  COMPANY
  CONTACT
  LEAD
  DEAL
  TASK
}

enum ActivityType {
  NOTE
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_ARCHIVED
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_ARCHIVED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_ARCHIVED
  DEAL_CREATED
  DEAL_UPDATED
  DEAL_STAGE_CHANGED
  DEAL_ARCHIVED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Organization {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String               @db.VarChar(160)
  slug        String               @unique @db.VarChar(80)
  status      OrganizationStatus   @default(ACTIVE)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  members     OrganizationMember[]
  teams       Team[]
  roles       Role[]
  userRoles   UserRole[]
  teamMembers TeamMember[]
  companies   Company[]
  contacts    Contact[]
  activities  Activity[]
  appearance    OrganizationAppearance?
  productConfig OrganizationProductConfig?
  leads         Lead[]
  pipelines     Pipeline[]
  deals         Deal[]
  tasks         Task[]

  @@index([status])
}

model User {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String               @unique @db.VarChar(254)
  firstName          String               @db.VarChar(80)
  lastName           String               @db.VarChar(80)
  status             UserStatus           @default(INVITED)
  identityProviderId String?              @unique @db.VarChar(255)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  memberships        OrganizationMember[]
  teamMemberships    TeamMember[]
  ownedCompanies     Company[]
  ownedContacts      Contact[]
  activities         Activity[] @relation("ActivityActor")
  ownedLeads         Lead[]
  ownedDeals         Deal[]
  assignedTasks      Task[] @relation("TaskAssignee")
  createdTasks       Task[] @relation("TaskCreator")

  @@index([status])
}

model OrganizationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  status         MembershipStatus @default(INVITED)
  joinedAt       DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  userRoles      UserRole[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model Team {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(100)
  description    String?      @db.VarChar(1000)
  status         TeamStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  members        TeamMember[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model TeamMember {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  teamId         String       @db.Uuid
  userId         String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, teamId, userId])
  @@index([organizationId, userId])
  @@index([teamId])
}

model Role {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?          @db.Uuid
  name           String           @db.VarChar(80)
  description    String?          @db.VarChar(1000)
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions    RolePermission[]
  userRoles      UserRole[]
  recordScopes   RoleRecordScope[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model RoleRecordScope {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId    String         @db.Uuid
  resource  RecordResource
  scope     RecordScope
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  role      Role           @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([roleId, resource])
  @@index([resource, scope])
}

model UserRole {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @db.Uuid
  userId         String             @db.Uuid
  roleId         String             @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership     OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)
  role           Role               @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, userId, roleId])
  @@index([roleId])
  @@index([userId])
}

model Company {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                 @db.Uuid
  ownerId         String                 @db.Uuid
  name            String                 @db.VarChar(180)
  domain          String?                @db.VarChar(255)
  phone           String?                @db.VarChar(40)
  website         String?                @db.VarChar(2048)
  industry        String?                @db.VarChar(120)
  lifecycleStatus CompanyLifecycleStatus @default(PROSPECT)
  archivedAt      DateTime?              @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner           User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contacts        Contact[]
  deals           Deal[]
  tasks           Task[]

  @@index([organizationId, archivedAt, name])
  @@index([organizationId, ownerId])
  @@index([organizationId, lifecycleStatus])
}

model Contact {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                 @db.Uuid
  ownerId         String                 @db.Uuid
  companyId       String?                @db.Uuid
  firstName       String                 @db.VarChar(80)
  lastName        String                 @db.VarChar(80)
  email           String?                @db.VarChar(254)
  phone           String?                @db.VarChar(40)
  jobTitle        String?                @db.VarChar(120)
  lifecycleStatus ContactLifecycleStatus @default(LEAD)
  archivedAt      DateTime?              @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner           User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company         Company?               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deals           Deal[]
  tasks           Task[]

  @@index([organizationId, archivedAt, lastName, firstName])
  @@index([organizationId, ownerId])
  @@index([organizationId, companyId])
  @@index([organizationId, lifecycleStatus])
  @@index([organizationId, email])
}

model Activity {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @db.Uuid
  actorUserId    String              @db.Uuid
  subjectType    ActivitySubjectType
  subjectId      String              @db.Uuid
  type           ActivityType
  body           String?             @db.VarChar(10000)
  metadata       Json?
  archivedAt     DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(3)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          User                @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, subjectType, subjectId, archivedAt, createdAt])
  @@index([organizationId, actorUserId, createdAt])
}

model OrganizationAppearance {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String       @unique @db.Uuid
  workspaceName    String       @default("RK Varaha CRM") @db.VarChar(80)
  primaryColor     String       @default("#0f766e") @db.VarChar(7)
  accentColor      String       @default("#14b8a6") @db.VarChar(7)
  sidebarColor     String       @default("#0f172a") @db.VarChar(7)
  pageBackground   String       @default("#f5f7fb") @db.VarChar(7)
  surfaceColor     String       @default("#ffffff") @db.VarChar(7)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
}


model OrganizationProductConfig {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @unique @db.Uuid
  companiesEnabled   Boolean      @default(true)
  contactsEnabled    Boolean      @default(true)
  leadsEnabled       Boolean      @default(true)
  dealsEnabled       Boolean      @default(true)
  tasksEnabled       Boolean      @default(true)
  activitiesEnabled  Boolean      @default(true)
  dashboardLabel     String       @default("Dashboard") @db.VarChar(40)
  companiesLabel     String       @default("Companies") @db.VarChar(40)
  contactsLabel      String       @default("Contacts") @db.VarChar(40)
  leadsLabel         String       @default("Leads") @db.VarChar(40)
  dealsLabel         String       @default("Deals") @db.VarChar(40)
  tasksLabel         String       @default("Tasks") @db.VarChar(40)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

model Lead {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  ownerId        String       @db.Uuid
  firstName      String       @db.VarChar(80)
  lastName       String       @db.VarChar(80)
  email          String?      @db.VarChar(254)
  phone          String?      @db.VarChar(40)
  companyName    String?      @db.VarChar(180)
  source         String?      @db.VarChar(120)
  status         LeadStatus   @default(NEW)
  notes          String?      @db.VarChar(5000)
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tasks          Task[]

  @@index([organizationId, archivedAt, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, email])
}

model Pipeline {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String          @db.Uuid
  name           String          @db.VarChar(120)
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stages         PipelineStage[]
  deals          Deal[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model PipelineStage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId  String   @db.Uuid
  name        String   @db.VarChar(120)
  position    Int
  probability Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  deals       Deal[]

  @@unique([pipelineId, position])
  @@unique([pipelineId, name])
}

model Deal {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  ownerId        String       @db.Uuid
  pipelineId     String       @db.Uuid
  stageId        String       @db.Uuid
  companyId      String?      @db.Uuid
  contactId      String?      @db.Uuid
  name           String       @db.VarChar(180)
  amount         Decimal?     @db.Decimal(14, 2)
  currency       String       @default("USD") @db.VarChar(3)
  status         DealStatus   @default(OPEN)
  closeDate      DateTime?    @db.Date
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stage          PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tasks          Task[]

  @@index([organizationId, archivedAt, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, pipelineId, stageId])
}

model Task {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  creatorId      String       @db.Uuid
  assigneeId     String       @db.Uuid
  companyId      String?      @db.Uuid
  contactId      String?      @db.Uuid
  leadId         String?      @db.Uuid
  dealId         String?      @db.Uuid
  title          String       @db.VarChar(180)
  description    String?      @db.VarChar(5000)
  dueAt          DateTime?    @db.Timestamptz(3)
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(OPEN)
  completedAt    DateTime?    @db.Timestamptz(3)
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator        User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignee       User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, archivedAt, status, dueAt])
  @@index([organizationId, assigneeId, status])
}
