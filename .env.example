# Local development only. Replace the password before starting.
NODE_ENV=development
API_PORT=3000
POSTGRES_USER=rk_varaha
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_DB=rk_varaha
DATABASE_URL=postgresql://rk_varaha:replace-with-your-local-password@localhost:5433/rk_varaha?schema=public
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Public identity settings; use HTTPS and exact production origins outside local development.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=rk-varaha-crm
KEYCLOAK_ISSUER=http://localhost:8080/realms/rk-varaha-crm
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/rk-varaha-crm/protocol/openid-connect/certs
KEYCLOAK_API_AUDIENCE=rk-varaha-api
KEYCLOAK_ADMIN_CLIENT_ID=rk-varaha-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-generated-server-secret
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-generated-database-secret
KC_BOOTSTRAP_ADMIN_USERNAME=local-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-generated-console-secret
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=rk-varaha-crm
VITE_KEYCLOAK_CLIENT_ID=rk-varaha-web
# Explicit operator bootstrap; set after creating and verifying the Keycloak user.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_IDENTITY_ID=
BOOTSTRAP_ORGANIZATION_SLUG=rk-varaha-dev
BOOTSTRAP_ADMIN_ROLE=ORG_ADMIN
